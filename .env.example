# Copy to .env.local for local development. Never commit real values.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.

# Public base URL of the site (used for metadata). Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Biteship Logistics API
BITESHIP_API_KEY=your-biteship-api-key
BITESHIP_BASE_URL=https://api.biteship.com
BITESHIP_ORIGIN_POSTAL_CODE=11450
BITESHIP_ORIGIN_AREA_ID=IDNP6IDNC149IDND847IDZ11450
